# Copy to .env and fill in. NEVER commit .env.

# ---- LLM (generation) ----
# Provider: "gemini" (free tier via Google AI Studio) or "anthropic" (Claude)
LLM_PROVIDER=gemini
# Put your Google Gemini API key here (get one free at https://aistudio.google.com/)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# For Anthropic (alternative):
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20241022

# ---- Embeddings (retrieval) ----
# fastembed = real local model (no API key). hash = offline test stand-in.
EMBEDDING_PROVIDER=fastembed   # use "hash" only for offline tests
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Qdrant ----
# Leave QDRANT_URL empty to use an embedded on-disk store in ./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=business_docs

# ---- Retrieval tuning ----
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=4
# Similarity cut-off. It depends on the embedding model! Run scripts.check_retrieval,
# look at the printed scores, and pick a value between "right answers" and "unrelated".
MIN_SCORE=0.40
